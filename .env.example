# Toolkit server configuration. Copy to .env (never commit it) and export the
# values in your shell; nothing reads .env automatically.  See docs/setup.md.

# development | test | production. UNSET MEANS PRODUCTION (fails closed).
NODE_ENV=development

# PostgreSQL the server and Prisma use.
DATABASE_URL=postgresql://eco:eco@localhost:5432/eco_dev

# Port of the API server (the Vite dev server proxies /api to it).
PORT=8787

# Random secret for sign-in sessions; at least 32 characters in production.
# Generate one: openssl rand -base64 32
AUTH_SECRET=

# Where people open the app, and where /api/auth is reached (same origin is
# recommended: serve the app and /api behind one host).
PUBLIC_APP_URL=http://localhost:5173
AUTH_BASE_URL=http://localhost:5173

# Google sign-in (Google Cloud console -> OAuth client, type "Web").
# Authorized redirect URI: <AUTH_BASE_URL>/api/auth/callback/google
# Required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development sign-in by email, no password. Only accepted when NODE_ENV is
# development or test: the server refuses to start with it in production.
AUTH_DEV_BYPASS=false

# Tests: a role that may CREATE DATABASE (each test file gets its own).
TEST_DATABASE_ADMIN_URL=postgresql://eco:eco@localhost:5432/postgres

# Browser: where the API is, if not /api on the same origin (build time).
# VITE_API_BASE=https://toolkit.example.com/api
